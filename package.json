{
  "name": "chocolate-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": { "node": ">=22.22.0" },
  "scripts": {
    "test": "pnpm run test:unit",
    "test:unit": "vitest run",
    "typecheck": "pnpm --recursive --filter './packages/**' --filter './apps/**' --fail-if-no-match run typecheck",
    "build": "pnpm --recursive --filter './packages/**' --filter './apps/**' --fail-if-no-match run build",
    "check": "pnpm run typecheck && pnpm run test:unit && pnpm run build"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
